{
  "name": "exudyn_python",
  "dockerFile": "Dockerfile",
  "runArgs": [
    "--name", "exudyn_python",
    "--privileged",
    "--network=host"
  ],
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": true,
  // Use X11 and Mesa software rendering for VS Code processes in the container.
  "remoteEnv": {
    "WAYLAND_DISPLAY": "",
    "LIBGL_ALWAYS_SOFTWARE": "1"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/${localWorkspaceFolderBasename},type=bind",
  "workspaceFolder": "/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.bash_history,target=/home/ubuntu/.bash_history,type=bind",
    "source=projectname-bashhistory,target=/commandhistory,type=volume"
],
"customizations": {
  // Configure properties specific to VS Code.
  "vscode": {
    // Use the container venv; overrides a (Windows) interpreter path from the local user settings.
    "settings": {
      "python.defaultInterpreterPath": "/python/venv/bin/python"
    },
    // Add the IDs of extensions you want installed when the container is created.
    "extensions": [
      "streetsidesoftware.code-spell-checker",
      "oderwat.indent-rainbow",
      "davidanson.vscode-markdownlint",
      "ms-python.python",
      "mhutchie.git-graph"
    ]

  }
}
}

